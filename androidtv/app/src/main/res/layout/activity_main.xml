<?xml version="1.0" encoding="utf-8"?>
<!--
    Tipografia grande e alto contraste: isto roda do outro lado de uma sala,
    numa televisão, para um público majoritariamente idoso.

    Toda gaveta aqui segue a mesma estrutura de três partes — cabeçalho em
    wrap_content, corpo em 0dp com peso 1, rodapé em wrap_content. É o que
    garante que o rodapé nunca cubra nada: o corpo fica com a sobra do que o
    cabeçalho e o rodapé não usaram, e encolhe sozinho se o conteúdo crescer.
    Nada aqui é posicionado por cima de nada.

    As larguras e alturas das gavetas foram medidas contra os 960x540dp de uma
    televisão 1080p e vivem em dimens.xml, porque o canal ao vivo é a razão do
    app existir e não pode sumir atrás de um painel.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:use_controller="false" />

        <!--
            Faixa ao vivo e dicas de tecla, empilhadas no canto superior.

            Ficam juntas num só container por dois motivos. Um: aparecem e somem
            sempre juntas, então uma visibilidade só é menos coisa para errar.
            Dois, e é o que importa: as dicas ficavam na base da tela e caíam em
            cima da tarja que o próprio canal queima no vídeo — telefone, PIX,
            CNPJ. Empilhá-las sob a faixa as põe onde a imagem está limpa, e
            empilhar em vez de posicionar por margem fixa faz o espaçamento
            continuar certo se a faixa mudar de altura.
        -->
        <LinearLayout
            android:id="@+id/overlay_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_4"
            android:orientation="vertical"
            android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:id="@+id/banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/overlay_pill"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Sem padding vertical de propósito. A etiqueta é match_parent
                     e recebe a altura da faixa; qualquer padding vertical aqui
                     sai dessa altura em vez de somar a ela, e foi o que antes
                     deixou 14px para um texto de 40px e o recortou até sumir. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/live_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_2"
                    android:paddingEnd="@dimen/space_2">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/circle_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="@string/live"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_3"
                    android:paddingTop="@dimen/space_2"
                    android:paddingEnd="@dimen/space_3"
                    android:paddingBottom="@dimen/space_2">

                    <TextView
                        style="@style/Text.Headline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/channel_name" />

                    <View
                        android:layout_width="@dimen/hairline_width"
                        android:layout_height="26dp"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_marginEnd="@dimen/space_2"
                        android:background="@color/hairline" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:format12Hour="dd/MM/yyyy  hh:mm a"
                        android:format24Hour="dd/MM/yyyy  HH:mm"
                        android:textColor="@color/text_secondary"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Onde o espectador descobre que existe algo além do vídeo. Uma
             view só, com as quatro teclas numa linha: nove views empilhadas
             desenhavam exatamente a mesma linha de texto, e o rodapé do painel
             da igreja já dizia a mesma coisa deste jeito. -->
        <TextView
            android:id="@+id/key_hints"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:background="@drawable/overlay_pill"
            android:maxLines="1"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_1"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_1"
            android:text="@string/key_hints_all" />

        </LinearLayout>

        <!-- Sintonizando / reconectando -->
        <LinearLayout
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim_full"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_8"
                    android:paddingTop="@dimen/space_6"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_6">

                    <ProgressBar
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/brand_blue" />

                    <TextView
                        android:id="@+id/statusTitle"
                        style="@style/Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4" />

                    <TextView
                        android:id="@+id/statusDetail"
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <include
            layout="@layout/panel_church_info"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Gaveta de vídeos. 310dp: antes eram 400dp de 540dp, três quartos da
             imagem. Cabeçalho fixo em cima, fileira ficando com o resto. -->
        <LinearLayout
            android:id="@+id/bottom_drawer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/drawer_videos_height"
            android:layout_gravity="bottom"
            android:background="@drawable/drawer_top"
            android:clickable="true"
            android:clipChildren="false"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_3"
            android:paddingEnd="@dimen/space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/rail_width"
                    android:layout_height="26dp"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/accent_rail" />

                <TextView
                    style="@style/Text.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/videos_title" />

                <TextView
                    android:id="@+id/videos_count"
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="@drawable/chip_outline"
                    android:fontFamily="monospace"
                    android:paddingStart="@dimen/space_1"
                    android:paddingTop="2dp"
                    android:paddingEnd="@dimen/space_1"
                    android:paddingBottom="2dp" />

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/back_up" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/youtube_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingEnd="@dimen/space_3" />
        </LinearLayout>

    </FrameLayout>

    <!-- Doação por PIX. 480dp: metade da tela, não os dois terços de antes. -->
    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="@dimen/drawer_pix_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/pix_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/brand_blue_dim"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/pix_title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="@color/outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:layout_weight="1"
                    android:background="@drawable/card_surface"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/qr_code_1"
                            android:layout_width="@dimen/qr_pix"
                            android:layout_height="@dimen/qr_pix"
                            android:padding="@dimen/space_1" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/pix_text_1"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_surface"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_2">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@android:color/white"
                        app:cardCornerRadius="@dimen/radius_sm"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/qr_code_2"
                            android:layout_width="@dimen/qr_pix"
                            android:layout_height="@dimen/qr_pix"
                            android:padding="@dimen/space_1" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:id="@+id/pix_text_2"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Número de conta em monoespaçado: é o que faz um número comprido
                 ser lido dígito por dígito em vez de decorado errado. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:background="@drawable/card_surface"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="@dimen/space_2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/bank_label"
                        android:textAllCaps="true" />

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/bank_value"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/agency_label"
                        android:textAllCaps="true" />

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/agency_value"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/account_label"
                        android:textAllCaps="true" />

                    <TextView
                        style="@style/Text.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="@string/account_value"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="@color/outline" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/back_left" />

    </LinearLayout>

    <!-- Pedidos de oração. 420dp, e a mesma estrutura de três partes da gaveta
         de PIX: duas gavetas que se abrem com teclas opostas devem se comportar
         igual. -->
    <LinearLayout
        android:id="@+id/left_drawer_content"
        android:layout_width="@dimen/drawer_prayer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_header"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/prayer_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/brand_blue_dim"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/prayer_title" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="@color/outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <!-- match_parent, não wrap_content: encolhido ao QR, o cartão dava
                 156dp de linha para a instrução, que quebrava em duas e era
                 cortada. Na largura da gaveta ela cabe numa linha só. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_2">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/radius_sm"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/qr_code_whatsapp"
                        android:layout_width="@dimen/qr_prayer"
                        android:layout_height="@dimen/qr_prayer"
                        android:contentDescription="@string/prayer_scan_hint"
                        android:padding="@dimen/space_1" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/prayer_scan_hint"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/prayer_scan_hint" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:background="@drawable/card_surface"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_2">

                <!-- Este rótulo era uma linha solta acima do QR e repetia o que
                     o cabeçalho já diz. Virou o rótulo do próprio cartão do
                     número, que é onde a informação pertence, e a linha que
                     sobrou era exatamente a altura que faltava para o número
                     caber em vez de ser espremido a três pixels. -->
                <TextView
                    android:id="@+id/prayer_subtitle"
                    style="@style/Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/prayer_subtitle" />

                <TextView
                    android:id="@+id/whatsapp_number_text"
                    style="@style/Text.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_number_2"
                    style="@style/Text.Number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_width"
            android:background="@color/outline" />

        <TextView
            style="@style/Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/space_3"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:text="@string/back_right" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
