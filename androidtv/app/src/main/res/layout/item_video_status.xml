<?xml version="1.0" encoding="utf-8"?>
<!--
    Fecha a fileira e diz o que ela está fazendo. Apertar para a direita numa
    televisão não dá noção de quanto falta: sem este bloco a fileira ou fica
    vazia enquanto carrega, ou simplesmente para de andar no último vídeo, e
    daí não há como distinguir "acabou" de "quebrou".

    A altura acompanha a do bloco de vídeo, então a linha de base da fileira
    não quebra quando ele entra.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/video_status_tile_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_2"
    android:background="@drawable/video_tile_background"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/video_tile_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/video_thumb_height"
        android:background="@drawable/card_dashed"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/statusSpinner"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/brand_blue" />

        <TextView
            android:id="@+id/statusIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_blue"
            android:textSize="40sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusTitle"
        style="@style/Text.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/statusDetail"
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
