<?xml version="1.0" encoding="utf-8"?>
<!--
    Tudo sobre a igreja numa tela só, sem nada para rolar nem para entrar: o
    espectador aperta para cima, lê, e aperta para cima de novo.

    Uma televisão 1080p tem só 540dp de altura, então o orçamento vertical aqui
    é apertado e deliberado: cabeçalho e rodapé fixos, uma linha com peso no
    meio. Os blocos de texto longo se ajustam sozinhos em vez de transbordar,
    porque o endereço da sede é buscado em tempo de execução e pode vir maior
    que o que está embutido.

    O peso dentro de peso que existia aqui saiu. Um layout_weight aninhado em
    outro obriga o Android a medir a tela duas vezes, e numa box fraca isso é
    a diferença que se sente ao abrir o painel.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/info_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim_panel"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_6"
    android:paddingTop="@dimen/space_4"
    android:paddingEnd="@dimen/space_6"
    android:paddingBottom="@dimen/space_3">

    <!-- Cabeçalho: bloco de marca, nome, e para onde a tecla de cima leva -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_3"
            app:cardBackgroundColor="@color/brand_blue_deep"
            app:cardCornerRadius="@dimen/radius_md"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                android:padding="@dimen/space_1"
                android:src="@mipmap/ic_launcher" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/church_name" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/church_tagline"
                android:textColor="@color/brand_blue"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:text="@string/info_dismiss_hint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_width"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginBottom="@dimen/space_2"
        android:background="@color/outline" />

    <!-- Corpo: foto, a história, os dados práticos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_4"
            android:layout_weight="3"
            app:cardBackgroundColor="@color/surface_raised"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="0dp">

            <!-- fitCenter e não centerCrop: a foto de origem tem 306x267, então
                 recortá-la para um cartão alto a ampliaria a mais do dobro do
                 próprio tamanho e cortaria as laterais. -->
            <ImageView
                android:id="@+id/info_hero"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/church_name"
                android:padding="@dimen/space_1"
                android:scaleType="fitCenter"
                android:src="@drawable/banner" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_4"
            android:layout_weight="4"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/rail_width"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_1"
                    android:background="@drawable/accent_rail" />

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_about_label" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_1"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/church_about"
                android:textColor="@color/text_secondary"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeTextType="uniform" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/rail_width"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_1"
                    android:background="@drawable/accent_rail" />

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_head_office_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/info_address"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:textColor="@color/text_secondary"
                app:autoSizeMaxTextSize="20sp"
                app:autoSizeMinTextSize="13sp"
                app:autoSizeTextType="uniform" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/rail_width"
                    android:layout_height="18dp"
                    android:layout_marginEnd="@dimen/space_1"
                    android:background="@drawable/accent_rail" />

                <TextView
                    style="@style/Text.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/info_contact_label" />
            </LinearLayout>

            <TextView
                android:id="@+id/info_email"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="@dimen/radius_sm"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/info_qr_site"
                        android:layout_width="@dimen/qr_site"
                        android:layout_height="@dimen/qr_site"
                        android:contentDescription="@string/info_site_label"
                        android:padding="@dimen/space_1" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/info_site_label" />

                    <TextView
                        style="@style/Text.Headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:text="@string/church_site" />

                    <!-- Duas linhas: "Mais de 554 igrejas no Brasil" não cabe em
                         uma na largura que sobra ao lado do QR, e o número vem
                         da rede — pode crescer. -->
                    <TextView
                        android:id="@+id/info_congregations"
                        style="@style/Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/hairline_width"
        android:layout_marginTop="@dimen/space_2"
        android:background="@color/outline" />

    <!-- Onde estão os outros painéis, para o controle nunca ser adivinhação -->
    <TextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/info_navigation_hint" />

</LinearLayout>
