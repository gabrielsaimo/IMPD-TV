<?xml version="1.0" encoding="utf-8"?>
<!--
    Uma televisão 1080p tem 960x540dp. Todo número aqui foi medido contra essa
    tela, e é por isso que os tamanhos das gavetas são o que são: antes a de
    vídeos tinha 400dp de altura, três quartos da imagem, e a do PIX 650dp de
    largura, dois terços. O canal ao vivo é a razão do app existir e sumia
    atrás delas.
-->
<resources>

    <!-- Escala de espaço. Seis valores, todos múltiplos de 8. -->
    <dimen name="space_1">8dp</dimen>
    <dimen name="space_2">16dp</dimen>
    <dimen name="space_3">24dp</dimen>
    <dimen name="space_4">32dp</dimen>
    <dimen name="space_6">48dp</dimen>
    <dimen name="space_8">64dp</dimen>

    <dimen name="radius_sm">8dp</dimen>
    <dimen name="radius_md">12dp</dimen>
    <dimen name="radius_lg">16dp</dimen>

    <dimen name="hairline_width">1dp</dimen>
    <dimen name="rail_width">4dp</dimen>
    <dimen name="focus_ring_width">4dp</dimen>

    <!-- Gavetas -->
    <dimen name="drawer_videos_height">310dp</dimen>
    <dimen name="drawer_pix_width">480dp</dimen>
    <dimen name="drawer_prayer_width">420dp</dimen>

    <!-- Bloco de vídeo. 240dp mais 16dp de margem numa tela de 960dp: cabem
         quatro. Com os 320dp de antes cabiam 2,8, e a fileira sempre parecia
         cortada porque estava mesmo. -->
    <dimen name="video_tile_width">240dp</dimen>
    <dimen name="video_tile_padding">8dp</dimen>
    <dimen name="video_thumb_height">126dp</dimen>
    <dimen name="video_status_tile_width">200dp</dimen>

    <!-- QR -->
    <dimen name="qr_pix">168dp</dimen>
    <!-- 208dp cabia na largura e não na altura: a gaveta de oração tem
         cabeçalho, rodapé e três blocos, e o LinearLayout espremia o último,
         que é justamente o do número de telefone. -->
    <dimen name="qr_prayer">132dp</dimen>
    <dimen name="qr_site">104dp</dimen>

</resources>
