<?xml version="1.0" encoding="utf-8"?>
<!-- Um anel sozinho lê como enfeite de longe. O bloco em foco também senta
     sobre um painel aceso, então qual está selecionado é óbvio até para quem
     não está procurando. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>
