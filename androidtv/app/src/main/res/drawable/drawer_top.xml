<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo da gaveta de vídeos. Sólido, nunca translúcido: uma gaveta
     transparente sobre vídeo ao vivo obriga mistura de camadas a cada quadro.
     A borda inferior fica fora da tela, por isso o contorno completo serve. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke android:width="@dimen/hairline_width" android:color="@color/outline" />
    <corners
        android:topLeftRadius="@dimen/radius_lg"
        android:topRightRadius="@dimen/radius_lg" />
</shape>
